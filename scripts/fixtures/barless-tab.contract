// LLP 1075.003 §3.7: both panels draw their tab's stack, so each tab is a
// navigation controller from launch (TabStacksIOSTests). Barless's root shows
// no bar until `titled` gives it a level-1 heading. Open Two pushes Detail
// and More in one batch. Titled starts with a bar. Bump changes a text no tab
// shows, Rename the Titled tab's own: a tab's face is read again only after
// the second (NavigationTabsIOSTests). Detail in Barless, from Titled,
// selects Barless and pushes onto it in one update.
routes nav
  tab barless "/"
    detail "/detail"
      more "/detail/more"
  tab titled "/titled"

component BarlessTab
  state titled = false
  state bumps = 0
  state renamed = false
  action pick(name: string)
    nav = select(nav, name)
  action open
    nav = push(nav, "/detail")
  action openTwo
    nav = push(push(nav, "/detail"), "/detail/more")
  action openFromTitled
    nav = open(nav, "/detail")
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action title
    titled = not titled
  action bump
    bumps = bumps + 1
  action rename
    renamed = not renamed
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
                if e.name == "titled" or e.name == "detail" or e.name == "more" or (e.name == "barless" and titled)
                  header display="flex" align-items="center" padding="8px 16px"
                    if e.name == "detail" or e.name == "more"
                      button id="back" press=back testId=`back-${e.name}` aria-label="Back"
                        text "Back"
                    text e.name role="heading" aria-level=(e.name == "barless" or e.name == "titled" ? 1 : 2)
                if e.name == "barless"
                  scroll flex=1 min-height=0
                    button press=open testId="open"
                      text "Open"
                    button press=openTwo testId="open-two"
                      text "Open two"
                    button press=title testId="title"
                      text "Title"
                    button press=bump testId="bump"
                      text "Bump"
                    button press=rename testId="rename"
                      text "Rename"
                    column height=1600
                  // Outside the scroller, so its batch is projected (`onlyListRows`).
                  text `Bumped ${bumps}` testId="bumps"
                if e.name == "titled"
                  button press=openFromTitled testId="open-from-titled"
                    text "Detail in Barless"
      row role="tablist"
        button role="tab" aria-controls="panel-barless" aria-selected=(nav.tab == "barless") press=pick("barless") testId="tab-barless" flex=1
          text "Barless"
        button role="tab" aria-controls="panel-titled" aria-selected=(nav.tab == "titled") press=pick("titled") testId="tab-titled" flex=1
          text (renamed ? "Renamed" : "Titled")
