// The native navigation fixture (LLP 1035.001.000): every way UIKit's chrome
// can change what it shows — the back button and its menu three deep, the
// swipe, a sheet pulled down with a screen it pushed, a sheet over a sheet,
// an alert over a sheet, a sheet held back by an alert, and seven tabs, so
// the More list — for `sim.mjs`, which drives them with real touches. Each
// screen's bar has one trailing button, the way on: a real button in the
// route's toolbar (LLP 1035.001.001 D6). Back reaches the app only as
// `traverse`, a tab only as `tabselect`.
routes nav
  tab home "/"
    deep "/deep"
      deeper "/deep/er"
        deepest "/deep/er/est"
    sheet "/sheet"
      inner "/sheet/inner"
  tab two "/two"
  tab three "/three"
  tab four "/four"
  tab five "/five"
  tab six "/six"
    six2 "/six/2"
  tab seven "/seven"

component NavFixture
  state alert = false
  state traverses = 0
  state backs = 0
  action selectTab(name: string)
    nav = select(nav, name)
  // The platform's Back of any depth: one event, its destination.
  action returnTo(entry: string)
    traverses = traverses + 1
    nav = backTo(nav, entry)
  action open(url: string)
    nav = push(nav, url)
  // Each screen's way on, from its bar's trailing button.
  action next(name: string)
    if name == "inner"
      alert = true
    else
      nav = push(nav, name == "home" ? "/deep" : (name == "deep" ? "/deep/er" : (name == "deeper" ? "/deep/er/est" : (name == "sheet" ? "/sheet/inner" : (name == "six" ? "/six/2" : "/sheet")))))
  // The alert's answer asks for a sheet while the alert is still leaving.
  action sheetAfterAlert
    alert = false
    nav = push(nav, "/sheet")

  view
    main testId="fixture" navigationKey=`${top(nav).id}` traverse=returnTo tabselect=selectTab width="100%" height="100%" background-color="#ffffff"
      each t in nav.tabs key=t.name
        each e in t.stack key=e.id
          column navigationKey=`${e.id}` navigationTab=t.name navigationTabTitle=t.name navigationTabSymbol="circle" navigationTitle=e.name navigationLargeTitle="false" navigationPresentation=(e.name == "sheet" ? "modal" : "") position="absolute" top=0 right=0 bottom=0 left=0 background-color="#ffffff" padding=120 display="flex" flex-direction="column"
            // The way on: a real button in the route's toolbar, which UIKit's
            // bar shows as its trailing item (LLP 1035.001.001 D6).
            when e.name != "deepest" and e.name != "six2" and e.name != "four"
              row role="toolbar" toolbarPlacement="navigation-bar" position="absolute" top=0 right=0
                button aria-label="Next" testId=`next-${e.name}` press=next(e.name) width=44 height=44
                  image "symbol:sf/chevron.forward" font-size=17 width=20 height=20
            text `${e.name} traverses=${traverses} backs=${backs}` testId=`counts-${e.name}`
            when e.name == "inner"
              dialog id="inner-alert" closedby="any" open=alert
                text "Alert over a sheet"
                button press=sheetAfterAlert commandfor="inner-alert" command="close" testId="alert-ok"
                  text "OK"
